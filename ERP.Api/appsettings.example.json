{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "app": {
    "name": "TeamMate"
  },
  "auth": {
    "issuer": "https://your-api.example",
    "audience": "https://your-api.example",
    "signingKey": "SET_USING_DEPLOYMENT_SECRETS",
    "expiry": "60"
  },
  "Db": {
    "connectionString": "SET_USING_DEPLOYMENT_SECRETS"
  },
  "EmailTemplates": {
    "PasswordReset": {
      "Subject": "Password reset",
      "Body": "Use the password reset link provided by the application."
    },
    "Welcome": {
      "Subject": "Welcome",
      "Body": "Welcome to TeamMate."
    },
    "OrderConfirmation": {
      "Subject": "Order confirmation",
      "Body": "Your order has been received."
    },
    "InquiryAlert": {
      "Subject": "New inquiry",
      "Body": "A new inquiry has been received."
    }
  },
  "EmailAddresses": {
    "Sales": "sales@example.com"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": "587",
    "Username": "SET_USING_DEPLOYMENT_SECRETS",
    "Password": "SET_USING_DEPLOYMENT_SECRETS",
    "FromEmail": "noreply@example.com",
    "EnableSsl": "true"
  },
  "ExternalApiSettings": {
    "CurrencyUrl": "https://your-currency-api.example"
  }
}
